{
  "name": "lumina-ai-chat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx server.ts",
    "dev:server": "cross-env NODE_ENV=development tsx server.ts",
    "build:server": "node -e \"const fs=require('fs');if(!fs.existsSync('dist'))fs.mkdirSync('dist')\" && esbuild server.ts --bundle --platform=node --format=cjs --sourcemap --outfile=dist/server.cjs --external:vite --external:onnxruntime-node --external:nodejs-whisper --external:@huggingface/transformers",
    "build": "vite build && npm run build:server",
    "prepare:desktop-runtime": "node scripts/prepare-desktop-runtime.mjs",
    "build:desktop": "npm run build && npm run prepare:desktop-runtime && tauri build",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.40",
    "@ai-sdk/cohere": "^4.0.28",
    "@ai-sdk/google": "^4.0.47",
    "@ai-sdk/groq": "^4.0.29",
    "@ai-sdk/mistral": "^4.0.30",
    "@ai-sdk/openai": "^4.0.44",
    "@ai-sdk/openai-compatible": "^3.0.32",
    "@anthropic-ai/claude-agent-sdk": "^0.3.237",
    "@anthropic-ai/sdk": "^0.120.0",
    "@earendil-works/pi-agent-core": "^0.84.2",
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@huggingface/transformers": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.1.0",
    "ai": "^7.0.70",
    "axios": "^1.19.0",
    "croner": "^10.0.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "gguf": "^1.0.7",
    "ignore": "^7.0.6",
    "lucide-react": "^1.33.0",
    "mammoth": "^1.12.1",
    "motion": "^13.1.1",
    "nodejs-whisper": "^0.3.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "systeminformation": "^5.33.1",
    "typebox": "^1.3.16",
    "uuid": "^14.0.2",
    "vite": "^8.2.2",
    "yaml": "^2.9.0",
    "youtube-transcript-plus": "^2.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~7.0.2",
    "vite": "^8.2.2"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.28.2"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "dompurify": "^3.4.10",
    "esbuild": "^0.28.2",
    "protobufjs": "^7.6.4",
    "sharp": "^0.35.3",
    "ws": "^8.21.0"
  }
